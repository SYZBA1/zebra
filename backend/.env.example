# PostgreSQL connection string (use the Supabase connection pooler URI)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase — used for JWT verification and admin operations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API (direct — no Lovable gateway)
GEMINI_API_KEY=your_gemini_api_key

# VoyageAI for embeddings / RAG
VOYAGE_API_KEY=your_voyage_api_key

# Resend for transactional email (direct — no Lovable gateway)
RESEND_API_KEY=your_resend_api_key

# Email address to receive feedback notifications
FEEDBACK_RECIPIENT_EMAIL=admin@example.com

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Server port
PORT=3001
